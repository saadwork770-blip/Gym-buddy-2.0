{
  "id": "./",
  "name": "GymBuddy — Adaptive Training",
  "short_name": "GymBuddy",
  "description": "Adaptive coaching that picks your weights, rebuilds your split around the days you can train, and works with no signal in the gym.",
  "lang": "en",
  "dir": "auto",
  "start_url": "index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#0e1013",
  "theme_color": "#0e1013",
  "categories": ["health", "fitness", "sports"],
  "icons": [
    { "src": "assets/img/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/img/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "assets/img/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/img/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    {
      "name": "Start today's workout",
      "short_name": "Workout",
      "url": "workout.html",
      "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Diet targets",
      "short_name": "Diet",
      "url": "diet.html",
      "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "This week's program",
      "short_name": "Program",
      "url": "program.html",
      "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
